{
  "name": "sprout-codex",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "小苗 for Codex: a local usage dashboard and pixel companion",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
